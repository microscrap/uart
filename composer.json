{
    "name": "microscrap/uart",
    "description": "Unix UART / Serial Bindings for The PHP Posi Extension",
    "type": "library",
    "version": "0.11.0",
    "keywords": [
        "framework",
        "scrapyard-io",
        "uart",
        "serial",
        "termios",
        "posi",
        "bindings"
    ],
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/uart/0.11.x/overview",
    "support": {
        "docs": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/uart/0.11.x/overview",
        "source": "https://github.com/microscrap/uart",
        "issues": "https://github.com/microscrap/uart/issues"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "ext-posi": "^0.11.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "suggest": {
        "scrapyard-io/framework": "^0.11.0 - GPIO application framework over Microscrap protocol bindings"
    },
    "autoload": {
        "psr-4": {
            "Microscrap\\Bindings\\UART\\": "src/"
        },
        "files": [
            "src/Helpers/uart-serial.php",
            "src/Helpers/uart-termios.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
