{
    "name": "microscrap/uart",
    "description": "Unix UART / Serial Bindings for The PHP Posi Extension",
    "type": "library",
    "version": "0.7.0",
    "keywords": [
        "framework",
        "scrapyard-io",
        "uart",
        "serial",
        "termios",
        "posi",
        "bindings"
    ],
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/uart/0.7.x/overview",
    "support": {
        "docs": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/uart/0.7.x/overview",
        "source": "https://github.com/microscrap/uart",
        "issues": "https://github.com/microscrap/uart/issues"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-posi": "^0.7.0",
        "microscrap/posix": "^0.7.0"
    },
    "suggest": {
        "scrapyard-io/gpio-framework": "GPIO application framework over Microscrap protocol bindings (^0.7)"
    },
    "autoload": {
        "psr-4": {
            "Microscrap\\Bindings\\UART\\": "src/"
        },
        "files": [
            "src/Helpers/uart-serial.php",
            "src/Helpers/uart-termios.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.7.x-dev",
            "dev-main": "0.7.x-dev",
            "dev-0.7.x": "0.7.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
